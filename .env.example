# SMTP credentials used by /app/api/contact to send form submissions
# (lead form, contact form, /contact page) as email. Copy this file to
# .env.local and fill in real values -- .env.local is gitignored.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Optional: defaults to SMTP_USER / contact.us@alphadigital.live if unset.
MAIL_FROM=no-reply@alphadigital.live
MAIL_TO=contact.us@alphadigital.live
